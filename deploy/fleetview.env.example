# Copy to /etc/fleetview.env and chmod 600. Both services read this.
# Generate a strong token, e.g.:  openssl rand -hex 24
FLEETVIEW_TOKEN=replace-with-a-long-random-secret

# Optional: origin-side Cloudflare Access JWT verification (defense-in-depth).
# Leave unset to skip (local/dev). When set, the server requires a valid
# Cf-Access-Jwt-Assertion on browser requests. See deploy/README.md.
# FLEETVIEW_ACCESS_TEAM=your-team.cloudflareaccess.com
# FLEETVIEW_ACCESS_AUD=<application-audience-tag-from-access>
